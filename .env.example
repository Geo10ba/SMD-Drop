# =============================================================================
# SMD DROP - CONFIGURAÇÃO DE AMBIENTE & SEGURANÇA
# =============================================================================

# --- 1. SUPABASE (BANCO DE DADOS & AUTENTICAÇÃO) ---
VITE_SUPABASE_URL=https://aghbrlihahygczzvxvim.supabase.co
# Chave pública para o frontend (com RLS configurado)
VITE_SUPABASE_ANON_KEY=sua_anon_key_publica_aqui
# Chave privada exclusiva para Webhooks e Scripts de Servidor (NUNCA expor no frontend!)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_secreta_aqui

# --- 2. MERCADO PAGO & CHECKOUT ---
# Access Token Privado do Mercado Pago (usado apenas pelas Serverless Functions em /api/mercadopago/*)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-access-token-privado-aqui
# Public Key do Mercado Pago (usada no frontend se necessário)
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-sua-public-key-aqui

# --- 3. TELEGRAM BOT NOTIFICATIONS (@smddropbot) ---
# Token privado do Bot do Telegram e ID do Chat para notificações de compras e recargas
TELEGRAM_BOT_TOKEN=seu_bot_token_telegram_aqui
TELEGRAM_CHAT_ID=seu_chat_id_telegram_aqui

# --- 4. LUMEN IA & MENTORIA DE VENDAS ---
# Chave de API da Groq para modelos de alta velocidade (usada pelo proxy /api/ai/chat)
GROQ_KEY=gsk_sua_chave_groq_aqui
ROUTER_KEY=sk_sua_chave_router_aqui
